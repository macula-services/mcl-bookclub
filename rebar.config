%% -*- mode: erlang -*-
%% rebar3 configuration for mcl-bookclub — the teaching service.
%%
%% A book club kept as a reckon-db event store, with projections into sqlite,
%% on the macula mesh through mcl_om. Four apps, one per division:
%%
%%   mcl_bookclub     the L2 service facade (mcl_om_service contract, health,
%%                    capabilities, store wiring)
%%   host_bookclub    CMD: commands, events, aggregates, policies
%%   project_bookclub PRJ: events -> sqlite read model
%%   query_bookclub   QRY: sqlite -> answers
%%
%% All four apps see the deps below (that is how an umbrella works). The
%% division boundary is enforced by tests, not by the build: query_bookclub
%% asserts its source imports no evoq or macula module, and a schema-contract
%% test in project_bookclub pins the columns QRY reads to the DDL PRJ writes.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health,
    %% and the reckon-db store mcl_om:boot/1 opens for a service exporting
    %% store_id/0 + data_dir/0.
    {mcl_om, "~> 0.28"},
    %% The CQRS/ES framework. 1.24: a restart's replayed events are marked
    %% (`replaying => true') and a handler declares its replay_policy.
    {evoq, "~> 1.24"},
    %% The reckon-db adapter, chosen in config/sys.config.src.
    {reckon_evoq, "~> 2.7"},
    %% The read model: a single sqlite file the PRJ app writes and the QRY app
    %% reads.
    {esqlite, "~> 0.9"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% A handler's callbacks live in evoq and the mesh SDK comes in only through
%% mcl_om; both would be "unknown" to the PLT without naming them here.
{dialyzer, [
    {warnings, [no_unknown]},
    {plt_extra_apps, [mcl_om, macula, evoq, reckon_evoq, reckon_db, esqlite]}
]}.

{relx, [
    {release, {mcl_bookclub, "0.1.0"},
     [mcl_bookclub, host_bookclub, project_bookclub, query_bookclub, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {test, [
        {eunit_opts, [{sys_config, "./config/test.sys.config"}]}
    ]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
