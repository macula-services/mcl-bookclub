{application, project_bookclub, [
    {description, "mcl-bookclub PRJ division: events to the sqlite read model."},
    {vsn, "0.1.0"},
    {registered, [bookclub_read_model_store]},
    {mod, {project_bookclub_app, []}},
    %% NOTE what is deliberately NOT here: host_bookclub. The projections
    %% read each aggregate's readable status names from the CMD status
    %% modules (bookclub_status & co), but those are PURE functions -- the
    %% call needs the module loaded, not the app started, same direction
    %% the desk dispatches these suites already use. Declaring the CMD app
    %% as a dependency here would boot its mesh emitters into the PRJ test
    %% env, and an emitter's mesh_unavailable error stalls the $all
    %% delivery every projection depends on. The facade's own boot order
    %% (host before project) covers the release.
    {applications, [
        kernel,
        stdlib,
        evoq,
        esqlite
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-bookclub"}]}
]}.
