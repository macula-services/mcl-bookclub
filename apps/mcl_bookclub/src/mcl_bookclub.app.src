{application, mcl_bookclub, [
    {description, "mcl-bookclub service facade: the mcl_om_service contract."},
    {vsn, "0.1.0"},
    {registered, [mcl_bookclub_sup]},
    {mod, {mcl_bookclub_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Mesh SDK, realm identity, capabilities, health.
        mcl_om,
        %% The three divisions, in boot order: their projections and stores
        %% register before mcl_om:boot/1 starts the store subscription, so a
        %% restart's catch-up replay finds every consumer already listening.
        host_bookclub,
        project_bookclub,
        query_bookclub
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-bookclub"}]}
]}.
