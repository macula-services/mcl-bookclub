{application, query_bookclub, [
    {description, "mcl-bookclub QRY division: answers from the sqlite read model."},
    {vsn, "0.1.0"},
    {registered, [bookclub_query_store]},
    {mod, {query_bookclub_app, []}},
    {applications, [
        kernel,
        stdlib,
        esqlite
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-bookclub"}]}
]}.
